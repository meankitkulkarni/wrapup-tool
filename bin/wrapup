#!/usr/bin/env bash
DRY_RUN="false"
VERBOSE="false"
TARGET_DIR="."

show_help() {
    echo "Usage: wrapup [options] [directory]"
    echo "  -h, --help      Show usage and exit"
    echo "  -n, --dry-run   Show what would happen, change nothing"
    echo "  -v, --verbose   Show detailed step-by-step output"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -n|--dry-run)
            DRY_RUN="true"
            ;;
        -v|--verbose)
            VERBOSE="true"
            ;;
        -*)
            echo "Error: Unknown flag '$1'. Run 'wrapup --help' for usage." >&2
            exit 1
            ;;
        *)
            TARGET_DIR="$1"
            ;;
    esac
    shift
done

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Target directory '$TARGET_DIR' not found." >&2
    exit 1
fi

if [ "$VERBOSE" = "true" ]; then echo "--> Step 1/3: Running clean-junk..."; fi
clean-junk "$TARGET_DIR" "$DRY_RUN" || exit 1

if [ "$VERBOSE" = "true" ]; then echo "--> Step 2/3: Running save-snap..."; fi
save-snap "$TARGET_DIR" "$DRY_RUN" || exit 2

if [ "$VERBOSE" = "true" ]; then echo "--> Step 3/3: Running fresh-screen..."; fi
fresh-screen "$DRY_RUN" || exit 1

exit 0