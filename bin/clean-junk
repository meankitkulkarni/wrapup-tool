#!/usr/bin/env bash
TARGET_DIR="${1:-.}"
DRY_RUN="${2:-false}"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi

if [ "$DRY_RUN" = "true" ]; then
    echo "[DRY-RUN] clean-junk: Would remove *.tmp, *.log, and __pycache__ in $TARGET_DIR"
    find "$TARGET_DIR" -maxdepth 2 \( -name "*.tmp" -o -name "*.log" -o -name "__pycache__" \)
else
    find "$TARGET_DIR" -maxdepth 2 \( -name "*.tmp" -o -name "*.log" -o -name "__pycache__" \) -exec rm -rf {} +
    echo "✔ Cleaned temporary files in $TARGET_DIR"
fi
exit 0